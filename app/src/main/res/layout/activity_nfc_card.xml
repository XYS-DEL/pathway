<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- NFC 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nfc_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nfc_card_status_no_hardware"
                android:textSize="15sp" />

            <Button
                android:id="@+id/nfc_go_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nfc_card_go_settings"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="#22000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_label_url"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nfc_url_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/nfc_card_url_empty"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_label_package"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nfc_package_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="@string/nfc_card_package_empty"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/nfc_btn_simulate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/nfc_card_btn_simulate" />

        <Button
            android:id="@+id/nfc_btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_btn_save" />

        <Button
            android:id="@+id/nfc_btn_load"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_btn_load" />

        <Button
            android:id="@+id/nfc_btn_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nfc_card_btn_share" />

    </LinearLayout>
</ScrollView>
