<?xml version="1.0" encoding="utf-8"?>
<!-- 可选中片：未选中为半透明白，选中为主题色实底。
     模式选择与锁定开关共用这一个。
     按下态分两条写，分别压在本分支常态之前：
     "选中+按下" 必须排在 "选中" 之前，否则按下时仍然是常态底色，看不出反馈。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下态用不透明实底，不是随手调色：半透明会随背后内容合成出不确定的对比度——
         #CC00695C（80% 不透明）压在浅色背景上合成成 #32867C，白字只剩 4.34:1，低于 AA 的 4.5:1；
         不透明的 #00695C 是 6.61:1，且比 colorPrimary 更深，按压变深本来就是正确的可供性。 -->
    <item android:state_checked="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00695C" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimary" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- 禁用态。位置只能在「按下态之后、兜底项之前」：
         选择器取**第一条匹配**，所以要排在选中/按下两条后面，它们的优先级才不变
         （禁用的选中片仍显示为选中，用户才分得清「选中但不可点」与「没选中」）；
         又必须排在最后那条无状态兜底项前面 —— 无状态项匹配一切，写它后面就是死代码。
         色值与 bg_tool_chip 的禁用意一致：淡，但胶囊还在。 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0FFFFFF" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</selector>
